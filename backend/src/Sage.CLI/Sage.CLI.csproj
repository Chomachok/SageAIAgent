<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>sage</ToolCommandName>
        <PackageId>Sage.CLI</PackageId>
        <Version>0.1.0</Version>
        <Authors>SageTeam</Authors>
        <Description>AI coding assistant</Description>
        <PackageTags>ai;coding;assistant</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BoxOfYellow.ConsoleMarkdownRenderer.Spectre" Version="0.12.5" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Sage.Core\Sage.Core.csproj" />
        <ProjectReference Include="..\Sage.Infrastructure\Sage.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>